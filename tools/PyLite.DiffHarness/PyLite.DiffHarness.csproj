<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>   <!-- a tool: never a NuGet package -->
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Outbridge.PyLite.DiffHarness</RootNamespace>
    <AssemblyName>Outbridge.PyLite.DiffHarness</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PyLite\PyLite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- IronPython 3.4.2 as the differential oracle; a dev-only dependency of this tool. -->
    <PackageReference Include="IronPython" Version="3.4.2" />
    <PackageReference Include="IronPython.StdLib" Version="3.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Loaded from the output directory when no -known path is given. -->
    <None Include="known-differences.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
