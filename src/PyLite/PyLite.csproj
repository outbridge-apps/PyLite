<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>Outbridge.PyLite</AssemblyName>
    <RootNamespace>Outbridge.PyLite</RootNamespace>
    <Version>1.0.0</Version>
    <Product>PyLite</Product>
    <Company>Outbridge</Company>
    <Authors>Outbridge</Authors>
    <Copyright>Copyright (c) 2026 Outbridge</Copyright>
    <Description>An embeddable interpreter of a Python dialect for .NET Framework hosts: managed-only, deterministic, with resource limits on steps, time, memory and depth.</Description>
    <PackageId>PyLite</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/outbridge-apps/PyLite</PackageProjectUrl>
    <RepositoryUrl>https://github.com/outbridge-apps/PyLite.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>python;interpreter;scripting;sandbox;embedded;net472</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NeutralLanguage>en</NeutralLanguage>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Numerics" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tokenizer/writer behind the json module and the hosting JSON marshalling. Pinned to 13.0.3:
         every 13.x shares AssemblyVersion 13.0.0.0, so a host that already loads one satisfies this
         reference without a binding redirect. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Outbridge.PyLite.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- The package carries the repository README, and only the public tree has the public one. -->
  <Target Name="RefusePackFromInternalTree" BeforeTargets="Pack"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\tests')">
    <Error Text="Pack from the public tree: this one has the internal README." />
  </Target>

</Project>
